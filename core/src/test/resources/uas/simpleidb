{

"Partitions" : {

  "batch" : {
    "IsDefaultPartition": "true",
    "Description" : "Default batch queue",
    "CPUArchitecture" : "x86_64",
    "Resources" : {
      "Runtime"       : "1-24h:1h",
      "Nodes"         : "1-1:1",
      "CPUsPerNode"   : "1-1:1",
      "TotalCPUs"     : "1-1",
      "MemoryPerNode" : "8G-8G"
    }
  }
 
 },

"Applications": [

  {
    "Name" : "Date",
    "Version" : "1.0",
    "Executable" : "/bin/date"
  },
  
  {
    "Name" : "Cat",
    "Version" : "1.0",
    "Executable" : "/bin/cat",
    "Arguments": [ "infile" ]
  },
  {
    "Name": "Bash shell",
    "Version": "5.1",
    "Executable": "/bin/bash",
    "Arguments": [
      "-d$DEBUG?",
      "-vVERBOSE?",
      "$OPTIONS?",
      "$SOURCE?",
      "$ARGUMENTS"
    ],
    "Parameters": {
      "SOURCE": {
        "Type": "filename"
      },
      "ARGUMENTS": {
        "Type": "string"
      },
      "DEBUG": {
      "Type": "boolean"
      },
      "VERBOSE": {
        "Type": "boolean"
      },
      "OPTIONS": {
        "Type": "string"
      }
      }
    }

]

}
